<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="620.0"
      prefWidth="430.0"
      styleClass="main-container"
      stylesheets="@../css/main.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="baby.MainWindow">
    <children>
        <Label styleClass="header-title" text="Baby's Winter Court" />

        <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="dialogContainer" spacing="8.0" />
            </content>
        </ScrollPane>

        <HBox spacing="8.0" styleClass="input-area">
            <children>
                <TextField fx:id="userInput"
                           onAction="#handleUserInput"
                           promptText="Enter a command, Your Highness"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" onAction="#handleUserInput" text="Send" />
            </children>
        </HBox>
    </children>
</VBox>
